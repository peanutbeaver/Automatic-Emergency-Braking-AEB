{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host: SIL simulator + unit tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-asan",
      "inherits": "host",
      "displayName": "Host with AddressSanitizer + UBSan",
      "binaryDir": "${sourceDir}/build/host-asan",
      "cacheVariables": { "AEB_SANITIZE": "ON" }
    },
    {
      "name": "cortex-m3",
      "displayName": "Firmware: bare-metal Cortex-M3 (runs in QEMU)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cortex-m3",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "cortex-m3", "configurePreset": "cortex-m3" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } },
    { "name": "host-asan", "configurePreset": "host-asan", "output": { "outputOnFailure": true } }
  ]
}
